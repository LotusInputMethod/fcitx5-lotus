#!/usr/bin/make -f
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

ifneq (,$(filter nocheck,$(DEB_BUILD_PROFILES)))
export DEB_BUILD_OPTIONS += nocheck
endif

%:
	dh $@ --buildsystem=cmake

override_dh_python3:
	dh_python3 --shebang=/usr/bin/python3

override_dh_dwz:
	@echo "Skipping dh_dwz (incompatible with mixed debug sections)"

override_dh_auto_configure:
	dh_auto_configure -- -DLOTUS_BYTECOMPILE_PYTHON=OFF -DBUILD_TESTING=$(if $(filter nocheck,$(DEB_BUILD_OPTIONS)),OFF,ON)
