#: settings-gui/ui/helpers.py:15
msgid "You can type tone marks at the end of the word or anywhere inside."
msgstr "Bạn có thể gõ dấu câu ở cuối từ hoặc bất cứ đâu."

#: settings-gui/ui/helpers.py:18
msgid ""
"Fix typing issues in Uinput mode for Chromium-based browsers like Chrome or "
"Edge."
msgstr ""
"Sửa lỗi gõ trong chế độ Uinput cho trình duyệt Chromium-based như Chrome "
"hoặc Edge."

#: settings-gui/ui/helpers.py:21
msgid ""
"Automatically match expansion case to trigger key case.\n"
"\n"
"Example if 'kg' is 'khô gà':\n"
"- kg -> khô gà\n"
"- Kg -> Khô gà\n"
"- KG -> KHÔ GÀ"
msgstr ""
"Tự động khớp chữ hoa/thường của từ được kích hoạt.\n"
"\n"
"Ví dụ nếu 'kg' là 'khô gà':\n"
"- kg -> khô gà\n"
"- Kg -> Khô gà\n"
"- KG -> KHÔ GÀ"

#: settings-gui/ui/helpers.py:28
msgid ""
"Automatically revert the typed sequence if the resulting word is not in the "
"dictionary.\n"
"This helps prevent accidental Vietnamese transformations on English words or "
"mixed text."
msgstr ""
"Tự động khôi phục chuỗi vừa gõ nếu từ đó không có trong từ điển.\n"
"Nó giúp tránh các trường hợp gõ các từ tiếng Anh mà bị chuyển đổi qua Tiếng "
"việt hoặc gõ song ngữ."

#: settings-gui/ui/helpers.py:32
msgid ""
"Allow macros to work when the input mode is OFF.\n"
"When disabled, macros are only available in active typing modes."
msgstr ""
"Cho phép gõ tắt hoạt động khi chế độ gõ đang là \"Tắt\"\n"
"Khi vô hiệu hoá, gõ tắt chỉ khả dụng trong các chế độ gõ được kích hoạt."

#: settings-gui/ui/helpers.py:36
msgid ""
"Press and release the selected modifier key before typing to skip macro "
"expansion for the next word.\n"
"If another key is pressed between the modifier's press and release, the skip "
"is cancelled."
msgstr ""
"Ấn phím được chọn trước khi gõ để bỏ qua phím tắt cho từ tiếp theo.\n"
"Nếu có phím được nhấn cùng phím này trước khi nhả phím, việc bỏ qua sẽ bị "
"huỷ."

