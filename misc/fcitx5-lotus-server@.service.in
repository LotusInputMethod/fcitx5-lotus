[Unit]
Description=Fcitx5 Lotus Server for %i
After=multi-user.target dev-uinput.device
Requires=dev-uinput.device

[Service]
User=@LOTUS_UINPUT_PROXY_USER@
Group=input

CapabilityBoundingSet=CAP_SYS_NICE CAP_SYS_PTRACE
AmbientCapabilities=CAP_SYS_NICE CAP_SYS_PTRACE

Type=simple

ExecStartPre=+/usr/bin/setfacl -m u:@LOTUS_UINPUT_PROXY_USER@:rw /dev/uinput
ExecStart=/usr/bin/fcitx5-lotus-server -u %i

Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
