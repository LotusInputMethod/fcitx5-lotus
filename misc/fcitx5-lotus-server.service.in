[Unit]
Description=Fcitx5 Lotus Server
After=systemd-modules-load.service systemd-udevd.service
Wants=systemd-modules-load.service

[Service]
User=@LOTUS_UINPUT_PROXY_USER@
Group=input

CapabilityBoundingSet=CAP_SYS_NICE CAP_SYS_PTRACE
AmbientCapabilities=CAP_SYS_NICE CAP_SYS_PTRACE

Type=simple

ExecStart=@CMAKE_INSTALL_FULL_BINDIR@/fcitx5-lotus-server

Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
